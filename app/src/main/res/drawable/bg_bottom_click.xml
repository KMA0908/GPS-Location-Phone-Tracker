<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="50dp" />

            <gradient
                android:angle="0"
                android:startColor="#E9F8ED"
                android:endColor="#A7EDF8" />
        </shape>
    </item>

    <!-- Background -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">

        <shape android:shape="rectangle">
            <corners android:radius="50dp" />
            <solid android:color="#FFFFFF" />
        </shape>

    </item>

</layer-list>