<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/friendSearchBottomSheet"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_gravity="bottom"
    android:layout_margin="16dp"

    app:cardBackgroundColor="#F6FFFFFF"
    app:cardCornerRadius="20dp"
    app:strokeColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Handle -->

        <View
            android:id="@+id/action_bar_friend_search"
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_handle"/>

        <!-- Search Header -->
        <LinearLayout
            android:id="@+id/layoutFriendSearchHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_bottom_nav_selected"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="@color/bg_switch_permission"/>

            <EditText
                android:id="@+id/edtFriendSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:hint="@string/search_friend"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textSize="14sp"
                android:autofillHints="name"/>

            <ImageView
                android:id="@+id/btnClearFriendSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/clear_search"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/color_999999"/>

        </LinearLayout>

        <!-- NO RESULTS -->
        <LinearLayout
            android:id="@+id/layoutNoFriendSearchResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_no_friend"/>

            <TextView
                android:id="@+id/tvNoFriendSearchResults"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/no_friends_found"
                android:textStyle="bold"
                android:textSize="16sp"/>

        </LinearLayout>

        <!-- LIST -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchFriends"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            android:visibility="visible"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
