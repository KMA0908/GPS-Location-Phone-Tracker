<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_f8f9fa">

    <!-- Hero Image -->
    <ImageView
        android:id="@+id/ivHero"
        android:layout_width="match_parent"
        android:layout_height="@dimen/d_350"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_paris"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvHeroAttribution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_80000000"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/d_16"
        android:paddingVertical="@dimen/d_4"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_11"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/ivHero" />

    <!-- Overlay Buttons -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/d_16"
        android:background="@drawable/bg_card"
        android:padding="@dimen/d_12"
        android:alpha="0.5"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/d_16"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="@dimen/d_13_5"
            android:alpha="0.5"
            android:src="@drawable/ic_love"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="@dimen/d_48"
            android:layout_height="@dimen/d_48"
            android:layout_marginStart="@dimen/d_12"
            android:background="@drawable/bg_card"
            android:alpha="0.5"
            android:src="@drawable/ic_share_profile"
            app:layout_constraintTop_toTopOf="parent" />
    </LinearLayout>

    <!-- Rating Badge Overlay -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/d_16"
        android:layout_marginTop="@dimen/d_100"
        app:cardBackgroundColor="@color/color_ccffffff"
        app:cardCornerRadius="@dimen/d_12"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/d_12"
            android:paddingVertical="@dimen/d_8">

            <ImageView
                android:layout_width="@dimen/d_16"
                android:layout_height="@dimen/d_16"
                android:src="@drawable/ic_star_famous" />

            <TextView
                android:id="@+id/tvHeaderRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/d_4"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                tools:text="4.7 (493k reviews)" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/d_300" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/d_32"
                app:cardElevation="@dimen/d_4"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/d_24">

                    <View
                        android:layout_width="@dimen/d_40"
                        android:layout_height="@dimen/d_4"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="@dimen/d_16"
                        android:background="@drawable/bg_handle"
                        android:backgroundTint="@color/color_e0e0e0" />

                    <TextView
                        android:id="@+id/tvPlaceName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sp_24"
                        android:textStyle="bold"
                        tools:text="Eiffel Tower" />

                    <TextView
                        android:id="@+id/tvPlaceLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/d_4"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/sp_14"
                        tools:text="Paris, France" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/d_16"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvOpenStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_card"
                            android:backgroundTint="@color/color_e8f5e9"
                            android:paddingHorizontal="@dimen/d_12"
                            android:paddingVertical="@dimen/d_8"
                            android:text="@string/open_now"
                            android:textColor="@color/color_2e7d32"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="@dimen/d_16"
                            android:layout_height="@dimen/d_16"
                            android:layout_marginStart="@dimen/d_16"
                            android:src="@drawable/ic_location_gray_famous"
                            app:tint="@color/color_666666" />

                        <TextView
                            android:id="@+id/tvDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/d_4"
                            android:textColor="@color/color_666666"
                            android:textSize="@dimen/sp_14"
                            tools:text="120 km" />
                    </LinearLayout>

                    <!-- Info Cards Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/d_20"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/cardVisitTime"
                            layout="@layout/item_detail_info_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <View
                            android:layout_width="@dimen/d_12"
                            android:layout_height="0dp" />

                        <include
                            android:id="@+id/cardHeight"
                            layout="@layout/item_detail_info_height"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <View
                            android:layout_width="@dimen/d_12"
                            android:layout_height="0dp" />

                        <include
                            android:id="@+id/cardRating"
                            layout="@layout/item_detail_info_rating"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/d_20"
                        android:lineSpacingExtra="@dimen/d_4"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/sp_14"
                        tools:text="The Eiffel Tower is a wrought-iron lattice tower on the Champ de Mars in Paris, France. It was completed in 1889 and is one of the most recognizable structures in the world." />

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/d_24"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/btnDirections"
                            layout="@layout/item_detail_direction_famous"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/btnStreetView"
                            layout="@layout/item_detail_street_view_famous"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/btnSave"
                            layout="@layout/item_detail_save_famous"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/btnCreateZone"
                            layout="@layout/item_detail_create_zone_famous"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <!-- Nearby Section -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/d_32">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nearby"
                            android:textColor="@color/black"
                            android:textSize="@dimen/sp_18"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/see_all"
                            android:textColor="@color/bg_switch_permission"
                            android:textSize="@dimen/sp_14"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/d_16"
                        android:columnCount="4"
                        android:alignmentMode="alignMargins"
                        android:useDefaultMargins="true">

                        <include
                            android:id="@+id/nearbyRestaurants"
                            layout="@layout/item_detail_nearby"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1" />

                        <include
                            android:id="@+id/nearbyHotels"
                            layout="@layout/item_detail_hotels"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1" />

                        <include
                            android:id="@+id/nearbyCafes"
                            layout="@layout/item_detail_cafe"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1" />

                        <include
                            android:id="@+id/nearbyAtms"
                            layout="@layout/item_detail_atms"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1" />

                    </GridLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExploreNow"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/d_60"
                        android:layout_marginTop="@dimen/d_32"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/explore_now"
                        android:textAllCaps="false"
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold"
                        app:backgroundTint="@color/bg_switch_permission"
                        app:cornerRadius="@dimen/d_30"
                        app:icon="@drawable/ic_arrow_right"
                        app:iconGravity="textEnd"
                        app:iconPadding="@dimen/d_8" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
