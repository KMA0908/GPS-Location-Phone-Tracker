<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_zones"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="@color/neutral08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/notification_filter_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Sort Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/sort_by"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNewest"
                style="@style/AlertFilterChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/newest_first" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSortAZ"
                style="@style/AlertFilterChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort_az" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSortZA"
                style="@style/AlertFilterChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort_za" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Status Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/status"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatusAll"
                style="@style/AlertFilterChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatusSafe"
                style="@style/AlertFilterChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/safe" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatusDangerous"
                style="@style/AlertFilterChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dangerous" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Days Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/time"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTimeAll"
                style="@style/AlertFilterChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_time" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTimeToday"
                style="@style/AlertFilterChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/today" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime7Days"
                style="@style/AlertFilterChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/last_7_days" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime30Days"
                style="@style/AlertFilterChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/last_30_days" />
        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnReset"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/reset"
                android:textColor="@color/black"
                app:cornerRadius="28dp" />

            <Button
                android:id="@+id/btnApply"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:backgroundTint="@color/bg_switch_permission"
                android:text="@string/apply"
                app:cornerRadius="28dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
