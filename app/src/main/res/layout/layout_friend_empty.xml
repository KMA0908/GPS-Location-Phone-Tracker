<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"

    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_marginTop="30dp"

    android:gravity="center"

    android:orientation="vertical">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_no_friend"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/no_friend_yet"
        android:textStyle="bold"
        android:textSize="16sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textSize="12sp"
        android:text="@string/add_friends_to_see_their_locations_on_the_map_in_real_time"
        android:textColor="#8A8A8A"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddFriendEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Add Friend"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        app:cornerRadius="28dp"
        app:iconGravity="textStart"
        app:icon="@drawable/ic_add_friend"
        app:backgroundTint="#30D158"/>

</LinearLayout>