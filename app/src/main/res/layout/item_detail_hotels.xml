<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/d_56"
        android:layout_height="@dimen/d_56"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/d_28"
        app:cardElevation="@dimen/d_2"
        app:strokeWidth="@dimen/d_1"
        app:strokeColor="@color/color_d3f6fc">

        <ImageView
            android:id="@+id/ivNearbyIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/ic_holtes" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvNearbyName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/d_8"
        android:textColor="@color/black"
        android:textSize="@dimen/sp_12"
        android:textStyle="bold"
        tools:text="Hotels" />

    <TextView
        android:id="@+id/tvNearbyCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/color_999999"
        android:textSize="@dimen/sp_10"
        tools:text="46 nearby" />

</LinearLayout>