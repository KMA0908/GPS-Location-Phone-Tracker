<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">
    <com.leansoft.ads.view.NativeAdViewContainer
        android:id="@+id/native_ad_view_container"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:ads_layout_loaded="@layout/layout_ad_native_media_big"
        app:ads_layout_loading="@layout/layout_ad_native_loading_media_big"
        app:layout_constraintBottom_toBottomOf="parent" />
    <TextView android:id="@+id/btn_next" android:layout_width="wrap_content" android:layout_height="48dp"
        android:layout_margin="12dp" android:gravity="center" android:minWidth="92dp" android:text="@string/next"
        android:fontFamily="@font/plus_jakarta_sans_semibold" android:includeFontPadding="false" android:textColor="@color/primary02" android:textSize="20sp" android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/native_ad_view_container" app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout android:id="@+id/onboarding_dots" android:layout_width="wrap_content" android:layout_height="48dp"
        android:layout_marginStart="24dp" android:gravity="center" android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/btn_next" app:layout_constraintStart_toStartOf="parent">
        <View android:id="@+id/dot_1" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_onboarding_dot" />
        <View android:id="@+id/dot_2" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="7dp" android:background="@drawable/bg_onboarding_dot" />
        <View android:id="@+id/dot_3" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="7dp" android:background="@drawable/bg_onboarding_dot" />
    </LinearLayout>
    <ImageView
        android:id="@+id/sw_onboard"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:contentDescription="@null"
        android:elevation="8dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/btn_next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_next" />
    <ImageView android:id="@+id/img_cover" android:layout_width="0dp" android:layout_height="0dp"
        android:scaleType="centerCrop" android:contentDescription="@null"
        app:layout_constraintBottom_toTopOf="@id/btn_next" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <View android:layout_width="0dp" android:layout_height="180dp" android:background="@drawable/bg_onboarding_bottom_fade"
        app:layout_constraintBottom_toBottomOf="@id/img_cover" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <TextView android:id="@+id/tv_title" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp" android:layout_marginBottom="8dp" android:gravity="center"
        android:fontFamily="@font/plus_jakarta_sans_semibold" android:includeFontPadding="false" android:textColor="@color/neutral01" android:textSize="22sp" android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tv_desc" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <TextView android:id="@+id/tv_desc" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp" android:layout_marginBottom="20dp" android:gravity="center"
        android:textColor="@color/neutral04" android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/img_cover" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
