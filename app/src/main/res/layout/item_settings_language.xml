<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="88dp">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:rippleColor="#142F65F5"
        app:strokeColor="@color/settings_language_stroke"
        app:strokeWidth="1dp">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/flagContainer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_settings_language_flag"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView android:id="@+id/ivLanguageFlag" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:scaleType="fitCenter" />
            </FrameLayout>
            <TextView
                android:id="@+id/tvLanguageName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/settings_language_name"
                android:textDirection="ltr"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@id/tvLanguageNativeName"
                app:layout_constraintEnd_toStartOf="@id/ivSelected"
                app:layout_constraintStart_toEndOf="@id/flagContainer"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />
            <TextView
                android:id="@+id/tvLanguageNativeName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/settings_language_native"
                android:textDirection="ltr"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivSelected"
                app:layout_constraintStart_toEndOf="@id/flagContainer"
                app:layout_constraintTop_toBottomOf="@id/tvLanguageName" />
            <ImageView
                android:id="@+id/ivSelected"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_settings_language_radio"
                android:padding="5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
