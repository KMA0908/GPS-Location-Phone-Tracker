<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:background="@drawable/bg_bottom_sheet_phone_number_locator_info"
    android:layout_marginHorizontal="@dimen/d_16"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"
        android:background="#000000" />

    <include
        android:id="@+id/layoutCountry"
        layout="@layout/item_phone_number_locator_info_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/d_20"/>

    <include
        android:id="@+id/layoutCarrier"
        layout="@layout/item_phone_number_locator_internet_card" />

</LinearLayout>
