<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/white"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp"
    app:shimmer_auto_start="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
        <View android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_ad_shimmer" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <View android:layout_width="190dp" android:layout_height="12dp" android:background="@drawable/bg_ad_shimmer" />
            <View android:layout_width="132dp" android:layout_height="10dp" android:layout_marginTop="8dp" android:background="@drawable/bg_ad_shimmer" />
        </LinearLayout>
        <View android:layout_width="92dp" android:layout_height="36dp" android:background="@drawable/bg_welcome_continue" />
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
