<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@android:color/white"
    android:background="@drawable/bg_gradient"
    app:cardCornerRadius="24dp"
    app:strokeWidth="1dp"
    app:strokeColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Icon -->
        <ImageView
            android:id="@+id/imgLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_location_permission"
            android:contentDescription="@null"
            android:scaleType="fitCenter"/>

        <!-- Title -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/allow_location_access"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#1F1F1F"/>

        <!-- Description -->
        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/realtime_tracker_needs_access_to_your_location_to_show_your_position_and_friends_around_you_in_real_time"
            android:textSize="12sp"
            android:textColor="#666666"
            android:lineSpacingExtra="2dp"/>

        <!-- Allow while using app -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAllowWhileUsing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="28dp"
            android:text="@string/allow_while_using_app"
            android:textAllCaps="false"
            android:padding="@dimen/d_16"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="#35C759"
            app:cornerRadius="28dp"/>

        <!-- Allow once -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAllowOnce"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="14dp"
            android:text="@string/allow_once"
            android:textAllCaps="false"
            android:padding="@dimen/d_16"
            android:textColor="#35C759"
            android:textSize="16sp"
            app:backgroundTint="#F5FAF5"
            app:cornerRadius="28dp"
            app:strokeColor="#DDE8DD"
            app:strokeWidth="1dp"/>

        <!-- Not now -->
        <TextView
            android:id="@+id/txtNotNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/not_now"
            android:textColor="#5D5D5D"
            android:textSize="16sp"
            android:padding="@dimen/d_16"
            android:textStyle="normal"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>