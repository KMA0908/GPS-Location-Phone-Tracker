<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginVertical="5dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:cardBackgroundColor="@color/language_card_sdk"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">
            <ImageView
                android:id="@+id/ivLanguageFlag"
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <TextView
                android:id="@+id/tvLanguageName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/neutral01"
                android:textDirection="ltr"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@id/tvLanguageNativeName"
                app:layout_constraintEnd_toStartOf="@id/ivSelected"
                app:layout_constraintStart_toEndOf="@id/ivLanguageFlag"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />
            <TextView
                android:id="@+id/tvLanguageNativeName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/neutral05"
                android:textDirection="ltr"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivSelected"
                app:layout_constraintStart_toEndOf="@id/ivLanguageFlag"
                app:layout_constraintTop_toBottomOf="@id/tvLanguageName" />
            <ImageView
                android:id="@+id/ivSelected"
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/ivClickLanguageGuide"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="end|top"
        android:clickable="false"
        android:elevation="8dp"
        android:focusable="false"
        android:rotation="-32"
        android:scaleType="fitCenter"
        android:translationX="40dp"
        android:translationY="-24dp"
        android:visibility="gone" />
</FrameLayout>
